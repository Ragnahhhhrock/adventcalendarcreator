{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adventcalendarcreator",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "COUNTER", "class_name": "Counter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }],
  "routes": [
    { "pattern": "adventcalendarcreator.com", "custom_domain": true },
    { "pattern": "www.adventcalendarcreator.com", "custom_domain": true }
  ]
}
